# Testnet JSON-RPC endpoint; default https://test.rpc.fastnear.com
NEAR_RPC_URL=
# Mainnet JSON-RPC endpoint for read only views; default https://free.rpc.fastnear.com
NEAR_MAINNET_RPC_URL=
# Archival JSON-RPC endpoint that dates a receiver when NearBlocks gives no creation time; default
# https://archival-rpc.testnet.fastnear.com for a testnet Gate, else https://archival-rpc.mainnet.fastnear.com
NEAR_ARCHIVAL_RPC_URL=
# Account the guard contract is deployed to
GATE_ACCOUNT_ID=
# Path to the live verifier key file, kept outside the repository
VERIFIER_KEY_FILE=
# Path to the agent function call key file, kept outside the repository
AGENT_KEY_FILE=
# ShieldBot API base URL; empty means off
SHIELDBOT_API_URL=
# NearBlocks API base URL
NEARBLOCKS_API_URL=
# Fixture mode: replay (default), record or off
GATE_FIXTURES_MODE=
# Set to 1 to let the pure Python signer sign with a live key; unset by default
GATE_ALLOW_PURE_PYTHON_SIGNER=
# Agent policy JSON the MCP server judges against; default {"allowlist": [], "caps": []}
GATE_POLICY=
