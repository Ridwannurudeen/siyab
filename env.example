# Environment reference for Siyab. Copy only the values needed into your shell.
# Keep key files outside the repository. FASTNEAR_API_KEY_FILE is a path, never a key value.

## Python code

# Testnet JSON-RPC endpoint override
NEAR_RPC_URL=
# Mainnet JSON-RPC endpoint override
NEAR_MAINNET_RPC_URL=
# Archival JSON-RPC endpoint override
NEAR_ARCHIVAL_RPC_URL=
# NearBlocks endpoint override
NEARBLOCKS_API_URL=
# Optional ShieldBot API base URL for firewall and memo checks
SHIELDBOT_API_URL=
# Gate account for the MCP server, the testnet scripts and python -m gate pay and attack; defaults to gate.near in the MCP server; pay and attack need an id ending in .testnet, which selects the testnet endpoints
GATE_ACCOUNT_ID=
# Reports contract account; when set, verdicts read its subject_summary for the payee
REPORTS_ACCOUNT_ID=
# Payment policy JSON used by the MCP server
GATE_POLICY=
# Path to the live verifier key file, kept outside the repository
VERIFIER_KEY_FILE=
# Path to the agent function call key file, kept outside the repository
AGENT_KEY_FILE=
# Fixture behavior: replay by default, record or off
GATE_FIXTURES_MODE=
# Set to 1 to enable the pure Python live signer
GATE_ALLOW_PURE_PYTHON_SIGNER=
# Set to 1 to enable MCP live signing when all required conditions hold
GATE_LIVE_SIGNING=
# Set to 1 to retain evidence directories after process exit
GATE_KEEP_EVIDENCE=
# Agent public key bound to the MCP live verdict and used by the scripts
AGENT_PUB=
# Feed state directory; defaults to intel/feed
FEED_STATE_DIR=
# Optional external provider key path for account, portfolio and scanner reads; sent only with a budget database
FASTNEAR_API_KEY_FILE=
# External provider budget database path; otherwise service entry points use their state directory
SIYAB_PROVIDER_BUDGET_DB=
# Set to 1 to enable the hosted verdict account-age fallback; disabled by default
SIYAB_VERDICT_NEARBLOCKS=
# Path to the dedicated Siyab Telegram bot token file outside the repository
SIYAB_TELEGRAM_TOKEN_FILE=
# Path to a file containing one HTTPS webhook URL; unset means alerts are off
SHIELDBOT_ALERT_URL_FILE=
# Path to the webhook signing secret file
SHIELDBOT_ALERT_SECRET_FILE=
# Set to 1 to use stdout when no webhook URL file is set
SHIELDBOT_ALERT_STDOUT=
# Path to the API keys file of python -m gate http, one key per line, kept outside the repository; the endpoint does not start without it
SHIELDBOT_API_KEYS_FILE=
# Requests per minute per API key for python -m gate http; defaults to 60
SHIELDBOT_API_RATE=

# Public workspace registration: open by default, or closed; valid access codes still register
SIYAB_REGISTRATION=
# Public registrations per UTC hour: 1 to 200, default 20
SIYAB_REGISTRATIONS_PER_HOUR=
# Public registrations per UTC day: 1 to 2000, at least the hourly cap, default 100
SIYAB_REGISTRATIONS_PER_DAY=
# Distinct public watched accounts: 0 to 500, default 90
SIYAB_WATCH_PUBLIC_ACCOUNTS=
# Distinct reserved watched accounts: 0 to 100, default 30
SIYAB_WATCH_RESERVED_ACCOUNTS=

## Testnet scripts

# Network selector; defaults to testnet and other values are refused
NETWORK=
# Set to 1 to print planned commands without reading keys or sending transactions
DRY_RUN=
# Account authorized to configure the Gate and registry
OWNER_ACCOUNT_ID=
# Optional report submitter; defaults to OWNER_ACCOUNT_ID with a warning
REPORTER_ACCOUNT_ID=
# Optional dispute opener; defaults to OWNER_ACCOUNT_ID with a warning
DISPUTER_ACCOUNT_ID=
# Evidence check mode for live_beat.sh: fetch by default, or local while the repository is private
EVIDENCE_CHECK=
# The Gate account above is also used as the contract account by these scripts
# Account used for the vendor payment path
VENDOR_ACCOUNT_ID=
# Account used for the aged payee path
AGED_PAYEE_ACCOUNT_ID=
# Our demo counterparty account; funds a lookalike receiver
COUNTERPARTY_ACCOUNT_ID=
# Deprecated fallback for the counterparty account when COUNTERPARTY_ACCOUNT_ID is unset
ATTACKER_ACCOUNT_ID=
# Directory for external account key files
NEAR_KEYS_DIR=
# Cold account that kill_switch.sh moves the Gate's token balance to; must be storage registered on the token
COLD_ACCOUNT_ID=
# Public verifier key passed to the Gate initializer
VERIFIER_PUB=
# Label stored with the agent
AGENT_LABEL=
# Test token symbol; defaults to DMT
TOKEN_SYMBOL=
# Test token decimals; defaults to 6
TOKEN_DECIMALS=
# Initial test token supply in base units
TOKEN_SUPPLY=
# Gate wasm path; defaults to res/gate.wasm with an external target fallback
GATE_WASM=
# Registry wasm path
REGISTRY_WASM=
# Test token wasm path
TOKEN_WASM=
# Build directory used by testnet setup; defaults outside the repository
CARGO_TARGET_DIR=
# Gate verdict lifetime in milliseconds; defaults to 300000
MAX_TTL_MS=
# Agent token cap per call, in whole tokens
CAP_PER_CALL=
# Agent token cap per window, in whole tokens
CAP_WINDOW=
# Agent cap window length in milliseconds
CAP_WINDOW_MS=
# Unknown payee token cap per call, in whole tokens
UNKNOWN_PER_CALL=
# Unknown payee token cap per window, in whole tokens
UNKNOWN_WINDOW=
# Function call key allowance in NEAR; defaults to 1
AGENT_ALLOWANCE_NEAR=
# Set to 1 to permit redeployment after 4 Nov
GATE_STATE_FROZEN=
# Expected version view after redeploy.sh; checked only when set
EXPECT_VERSION=
# Expected account code hash after redeploy.sh; checked only when set
EXPECT_CODE_HASH=
# Set to 1 only after the mainnet deployment prerequisites and owner approval
MAINNET_DEPLOY_OK=
# Set to 1 for deploy_registry_mainnet.sh to redeploy an initialized registry; requires both EXPECT variables
REDEPLOY=
# HOME comes from the login shell (scripts/lib.sh reads it to find the external build directory and account configuration); do not set it here
