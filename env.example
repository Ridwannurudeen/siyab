# Environment reference for ShieldBot for NEAR. Copy the lines you need into your shell or a local
# .env file that stays out of git; never put a key in this file. Empty values mean the default.

## Read by the Python code (gate/, intel/, mcp/)

# Testnet JSON-RPC endpoint; default https://test.rpc.fastnear.com
NEAR_RPC_URL=
# Mainnet JSON-RPC endpoint for read only views; default https://free.rpc.fastnear.com
NEAR_MAINNET_RPC_URL=
# Archival JSON-RPC endpoint that dates a receiver when NearBlocks gives no creation time; default
# https://archival-rpc.testnet.fastnear.com for a testnet Gate, else https://archival-rpc.mainnet.fastnear.com
NEAR_ARCHIVAL_RPC_URL=
# Account the guard contract is deployed to; the MCP server defaults to gate.near, and a .testnet id
# selects the testnet endpoints
GATE_ACCOUNT_ID=
# Path to the live verifier key file, kept outside the repository
VERIFIER_KEY_FILE=
# Set to 1 to let the MCP server sign with the live key; it then also needs VERIFIER_KEY_FILE, AGENT_PUB,
# GATE_FIXTURES_MODE=off, a .testnet GATE_ACCOUNT_ID and GATE_POLICY unset, and refuses otherwise; unset by default
GATE_LIVE_SIGNING=
# Path to the agent function call key file, kept outside the repository
AGENT_KEY_FILE=
# ShieldBot API base URL for the memo injection scan and the firewall; empty means off
SHIELDBOT_API_URL=
# NearBlocks API base URL; default https://api.nearblocks.io, or https://api-testnet.nearblocks.io for a testnet Gate
NEARBLOCKS_API_URL=
# Fixture mode, one of three:
#   replay (default) answers from fixtures/ only; a request with no fixture reads Unknown, never a pass
#   record answers from a fixture younger than 24 hours, otherwise fetches and writes the fixture
#   off fetches every time and writes nothing
GATE_FIXTURES_MODE=
# Set to 1 to let the pure Python signer sign with a live key; unset by default
GATE_ALLOW_PURE_PYTHON_SIGNER=
# Agent policy JSON (the get_agent shape) the MCP server checks payments against; default {"allowlist": [], "caps": []};
# unset for live signing, which reads get_agent
GATE_POLICY=
# Set to 1 to keep the evidence directory python -m gate demo and the MCP server write when the process exits;
# unset by default, which removes it
GATE_KEEP_EVIDENCE=

## Read by the testnet scripts (scripts/*.sh, see scripts/README.md); GATE_ACCOUNT_ID above as well

# Network; default testnet, the only value the scripts accept
NETWORK=
# Set to 1 to print the planned command lines without reading a key or sending a transaction
DRY_RUN=
# Account authorized to configure the Gate and the registry
OWNER_ACCOUNT_ID=
# Account used for the vendor payment path
VENDOR_ACCOUNT_ID=
# Account used for the aged payee path
AGED_PAYEE_ACCOUNT_ID=
# Account that funds the lookalike receiver
ATTACKER_ACCOUNT_ID=
# Directory of <account>.json key files, outside the repository
NEAR_KEYS_DIR=
# Public verifier key passed to the Gate initializer, as ed25519:<base58>
VERIFIER_PUB=
# Function call public key registered with the Gate, as ed25519:<base58>; also read by the MCP server for live signing
AGENT_PUB=
# Label stored with the agent
AGENT_LABEL=
# Test token symbol; default DMT
TOKEN_SYMBOL=
# Test token decimals; default 6
TOKEN_DECIMALS=
# Initial test token supply in base units
TOKEN_SUPPLY=
# Gate wasm path; default res/gate.wasm, falling back to $CARGO_TARGET_DIR/near/gate.wasm
GATE_WASM=
# Registry wasm path
REGISTRY_WASM=
# Test token wasm path
TOKEN_WASM=
# Build directory outside the repository; default $HOME/target/shieldbot-near
CARGO_TARGET_DIR=
# Gate verdict lifetime in milliseconds; default 300000
MAX_TTL_MS=
# Agent token cap per call, in whole tokens
CAP_PER_CALL=
# Agent token cap per window, in whole tokens
CAP_WINDOW=
# Agent cap window length in milliseconds
CAP_WINDOW_MS=
# Unknown payee token cap per call, in whole tokens
UNKNOWN_PER_CALL=
# Unknown payee token cap per window, in whole tokens
UNKNOWN_WINDOW=
# Function call key allowance in NEAR; default 1
AGENT_ALLOWANCE_NEAR=
# Must equal 1 to redeploy after 4 Nov
GATE_STATE_FROZEN=
