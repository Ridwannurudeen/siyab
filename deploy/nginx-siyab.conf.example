# Template the operator adapts to the existing siyab.xyz HTTPS configuration.
# Include these zones, map and server in the http context.
# Adapt listeners and TLS certificates before use.
# A CDN in front must restore the real client address first, using trusted
# proxy addresses, before these limits and X-Forwarded-For are applied.
limit_req_zone $binary_remote_addr zone=siyab_general:10m rate=60r/m;
map $uri $siyab_heavy_address {
    default "";
    ~^/live/accounts/[^/]+/(portfolio|portfolio-at-block|holdings|graph|backfill)/?$ $binary_remote_addr;
}
limit_req_zone $siyab_heavy_address zone=siyab_heavy:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=siyab_connections:10m;

server {
    listen 80;
    server_name siyab.xyz;
    limit_req_status 429;
    limit_conn_status 429;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering on;
    proxy_cache off;

    # API starting values for operator tuning: averages of 60 and 10 requests
    # a minute, with immediate bursts of 20 and 2 and 12 connections per address.
    # The application queues up to 12 requests per client and runs at most 4 at once.
    location ~ ^/live(/|$) {
        limit_req zone=siyab_general burst=20 nodelay;
        limit_req zone=siyab_heavy burst=2 nodelay;
        limit_conn siyab_connections 12;
        proxy_pass http://127.0.0.1:8792;
    }

    location ~ ^/workspace-api(/|$) {
        limit_req zone=siyab_general burst=20 nodelay;
        limit_req zone=siyab_heavy burst=2 nodelay;
        limit_conn siyab_connections 12;
        proxy_pass http://127.0.0.1:8792;
    }

    location / {
        proxy_pass http://127.0.0.1:8792;
    }
}
