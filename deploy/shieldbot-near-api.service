[Unit]
Description=Siyab read only API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shieldbot-near
Group=shieldbot-near
WorkingDirectory=/opt/shieldbot-near
EnvironmentFile=/etc/shieldbot-near/env
ExecStart=/usr/bin/python3 -m intel serve --host 127.0.0.1 --port 8787 --site demo/site
Restart=on-failure
RestartSec=5
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shieldbot-near

[Install]
WantedBy=multi-user.target
