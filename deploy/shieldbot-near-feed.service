[Unit]
Description=ShieldBot NEAR finalized block feed
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shieldbot-near
Group=shieldbot-near
WorkingDirectory=/opt/shieldbot-near
EnvironmentFile=/etc/shieldbot-near/env
ExecStart=/usr/bin/python3 -m intel feed --follow
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shieldbot-near

[Install]
WantedBy=multi-user.target
